{
  "name": "litertlm_web_demo",
  "version": "1.0.0",
  "description": "A local workspace for document reading, questions and source references",
  "main": "index.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test:papers": "node scripts/verify-paper-fixtures.mjs",
