    "lit": "^3.3.3",
    "lucide": "^1.48.0",
    "marked": "^18.0.4",
    "marked-highlight": "^2.2.1",
    "officeparser": "^8.0.0",
    "pdfjs-dist": "6.2.108",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "@types/node": "26.6.3",
    "@webgpu/types": "^0.1.69",
    "jasmine": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^6.4.2"
  }
